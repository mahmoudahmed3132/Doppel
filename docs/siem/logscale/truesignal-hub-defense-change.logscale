// truesignal-hub-defense-change: successful Hub admin change that can blind detection (low; high for clear events / factory reset).
// Elastic twin: Docs/siem/elastic/truesignal-hub-defense-change.json
// Schedule: every 5m over the last 6m.
event.module="truesignal" event.dataset="truesignal.audit" event.outcome="success"
| in(field="event.action", values=[
    "config.update", "system.arm", "system.password_change", "system.factory_reset", "sensor.silence", "node.delete", "sensor.delete", "events.delete_all", "events.archive_all", "beacon.delete", "assets.replace", "mfa.recovery_codes_regenerate", "siem.update", "webhook.update"])
| case {
    in(field="event.action", values=["events.delete_all", "system.factory_reset"]) | rule_severity := "high";
    in(field="event.action", values=["assets.replace", "system.password_change", "beacon.delete", "mfa.recovery_codes_regenerate"]) | rule_severity := "low";
    * | rule_severity := "medium";
  }
| table([@timestamp, rule_severity, event.action, url.path, source.ip])
