{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping Doppel Hub TS_METRICS_ADDR (/metrics)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Doppel Hub self-health: fleet liveness, ingest throughput/rejections, SIEM queue and drops, webhook delivery, heartbeat lag, HTTP and SQLite latency.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes Online / Offline",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "doppel_nodes{state=\"online\"}", "legendFormat": "online", "refId": "A" },
        { "expr": "doppel_nodes{state=\"offline\"}", "legendFormat": "offline", "refId": "B" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sensors by State",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "doppel_sensors", "legendFormat": "{{state}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SIEM Queue Depth",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "doppel_siem_queue_depth", "legendFormat": "{{output}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Hub Build Info",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "doppel_build_info", "legendFormat": "v{{version}} (schema {{schema}})", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Events Ingested Rate (by severity, drill)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (severity, drill) (rate(doppel_events_ingested_total[5m]))",
          "legendFormat": "{{severity}} (drill={{drill}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ingest Rejections (by code)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (code) (rate(doppel_ingest_rejected_total[5m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "SIEM Sent vs Dropped Rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "rate(doppel_siem_sent_total[5m])", "legendFormat": "sent ({{output}})", "refId": "A" },
        { "expr": "rate(doppel_siem_dropped_total[5m])", "legendFormat": "dropped ({{output}})", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Notifications Sent vs Failed",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(doppel_notify_sent_total[5m])", "legendFormat": "sent ({{route}})", "refId": "A" },
        { "expr": "rate(doppel_notify_failed_total[5m])", "legendFormat": "failed ({{route}})", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Sensor Heartbeat Lag (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(doppel_heartbeat_lag_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(doppel_heartbeat_lag_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(doppel_heartbeat_lag_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP Request Latency (p50 / p95) & Rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(doppel_http_request_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(doppel_http_request_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "SQLite Query Latency (p50 / p95)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(doppel_db_query_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(doppel_db_query_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP Requests by Route and Status Code",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "expr": "sum by (route, code) (rate(doppel_http_requests_total[5m]))", "legendFormat": "{{route}} [{{code}}]", "refId": "A" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Sensor-Reported Dropped Events",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "doppel_sensor_dropped_events", "legendFormat": "{{node}} / {{sensor}}", "refId": "A" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["doppel", "deception", "self-health"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Doppel Hub Self-Health",
  "uid": "doppel-hub-self-health",
  "version": 1
}
